# Configuración de Olla Gitana Music Backend
PORT=8000
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/olla_gitana.db

# Credenciales de Spotify Web API (opcional, para previews de 30s y carátulas)
# Obtén tus credenciales en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Configuración de Olla Gitana Music Backend
PORT=8000
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/olla_gitana.db

# Token compartido para operaciones de escritura (subir, votar, borrar, analizar).
# Déjalo vacío en red local de ensayo. OBLIGATORIO si expones el backend por túnel.
API_TOKEN=

# Credenciales de Spotify Web API (opcional, para previews de 30s y carátulas)
# Si se dejan vacías, se usan Deezer e iTunes (públicos, sin claves).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
